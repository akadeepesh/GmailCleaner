# Copy this to .env and fill in your values.
# .env is gitignored and must never be committed.

# ── Google OAuth ──────────────────────────────────────────────────────────────
# OAuth client credentials JSON downloaded from Cloud Console (Desktop app).
GOOGLE_CREDENTIALS_PATH=config/credentials.json

# Where the OAuth token is stored after the first login (python main.py info).
GOOGLE_TOKEN_PATH=config/token.json

# Production only: the token JSON itself. Cloud Run injects this from
# Secret Manager; when set it takes precedence over GOOGLE_TOKEN_PATH.
# GOOGLE_TOKEN_JSON=

# Set to 1 to fail fast instead of opening a browser for consent
# (auto-detected on Cloud Run).
# GMAILCLEANER_HEADLESS=0

# ── AI triage ─────────────────────────────────────────────────────────────────
# Google AI Studio API key for Gemini. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Dashboard ─────────────────────────────────────────────────────────────────
# Token required to open the dashboard. Leave empty ONLY for local use.
DASHBOARD_SECRET=

# Public dashboard URL, linked from the digest email.
# DASHBOARD_URL=https://gmail-cleaner-dashboard-xxxx.run.app

# Webhook verification: the Pub/Sub push audience (the /webhook/pubsub URL)
# and the service account that signs push requests.
# PUBSUB_AUDIENCE=
# PUBSUB_SERVICE_ACCOUNT=

# ── Overrides for settings.yaml ───────────────────────────────────────────────
# GMAILCLEANER_ACCOUNT=      # same as --account
# GMAILCLEANER_CONFIG=config/settings.yaml
# DATABASE_PATH=data/gmailcleaner.db
# PENDING_ACTIONS_PATH=output/pending_actions.json
# PUBSUB_TOPIC=projects/<project-id>/topics/gmail-cleaner-notifications
# DIGEST_RECIPIENT=
# SQLITE_JOURNAL_MODE=WAL    # use DELETE on network filesystems

# ── Deployment ────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
# GCP_REGION=us-central1

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
