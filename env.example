# Copy this to .env and fill in your values.
# .env is gitignored and must never be committed.

# Path to your Google OAuth credentials JSON downloaded from Cloud Console.
# For local development only. In production, use Secret Manager.
GOOGLE_CREDENTIALS_PATH=config/credentials.json

# Path where GmailCleaner stores the OAuth token after first login.
# For local development only. In production, use Secret Manager.
GOOGLE_TOKEN_PATH=config/token.json

# Google AI Studio API key for Gemini (Phase 3).
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# GCP project ID (required for Cloud Run deployment).
GCP_PROJECT_ID=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
