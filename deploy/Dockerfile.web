# GmailCleaner — Web dashboard & Pub/Sub webhook (Cloud Run Service)
#
# This is a persistent HTTP server, distinct from the scheduled Cloud Run Job.
# It serves:
#   - The web dashboard (GET routes, /api/*)
#   - The Pub/Sub webhook endpoint (POST /webhook/pubsub)
#
# Build:        docker build -t gmailcleaner-web -f deploy/Dockerfile.web .
# Run locally:  docker run --rm -p 8080:8080 \
#                 -e GOOGLE_TOKEN_JSON="$(cat config/token.json)" \
#                 -e DASHBOARD_SECRET=change-me \
#                 -v "$(pwd)/data:/app/data" \
#                 -e DATABASE_PATH=/app/data/gmailcleaner.db \
#                 -e PENDING_ACTIONS_PATH=/app/data/pending_actions.json \
#                 gmailcleaner-web
#               then open http://localhost:8080/?token=change-me

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    GMAILCLEANER_HEADLESS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY version.py main.py ./
COPY core/        core/
COPY auth/        auth/
COPY ai/          ai/
COPY gmail/       gmail/
COPY engines/     engines/
COPY store/       store/
COPY output/      output/
COPY pubsub/      pubsub/
COPY web/         web/
COPY config/settings.yaml config/settings.yaml

RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin appuser \
    && mkdir -p data output logs \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8080

# One worker process: the SQLite DB lives on a shared volume, so a single
# writer process is the safe choice. Threads handle concurrent requests.
# A long timeout lets /api/execute finish large unsubscribe batches.
CMD exec gunicorn \
    --bind "0.0.0.0:${PORT:-8080}" \
    --workers 1 \
    --threads 8 \
    --timeout 300 \
    --access-logfile - \
    --error-logfile - \
    "web.app:create_app()"
